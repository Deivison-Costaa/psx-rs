@@PARA
        let w_raw = (size_word & 0xFFFF) as u16;
@@FIM
@@DE
        let xsiz = ((raw_w as u32 & 0x3FF) + 0x0F) & !0x0F;
@@PARA
        let xsiz = ((w_raw as u32 & 0x3FF) + 0x0F) & !0x0F;
@@FIM

