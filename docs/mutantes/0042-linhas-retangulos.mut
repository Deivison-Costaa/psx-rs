mutante: m3
rotulo: troca R e B em color24_to_16 (na borda, C1 da 0038 indicou essa classe de mutante)
@@DE
fn color24_to_16(color24: u32) -> u16 {
    let r = (color24 & 0xFF) as u8;
    let g = ((color24 >> 8) & 0xFF) as u8;
    let b = ((color24 >> 16) & 0xFF) as u8;
@@PARA
fn color24_to_16(color24: u32) -> u16 {
    let b = (color24 & 0xFF) as u8;
    let g = ((color24 >> 8) & 0xFF) as u8;
    let r = ((color24 >> 16) & 0xFF) as u8;
@@FIM

