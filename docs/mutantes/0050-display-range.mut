# Manifesto de mutação da iteração 0050 — display range registers
formato: 1
iteracao: 0050
item: 2.7a
alvo: crates/psx-core/src/gpu.rs
teste: gpu_display_range

mutante: m1
rotulo: GP1(05h) troca mascaras de X e Y (X usa 0x1FF, Y usa 0x3FF)
@@DE
                self.display_vram_x.set((val & 0x3FF) as u16);
                self.display_vram_y.set(((val >> 10) & 0x1FF) as u16);
@@PARA
                self.display_vram_x.set((val & 0x1FF) as u16);
                self.display_vram_y.set(((val >> 10) & 0x3FF) as u16);
@@FIM

mutante: m2
rotulo: GP1(06h) mascara de X1 errada (0x3FF em vez de 0xFFF)
@@DE
                self.display_x1.set((val & 0xFFF) as u16);
@@PARA
                self.display_x1.set((val & 0x3FF) as u16);
@@FIM

mutante: m3
rotulo: GP1(07h) mascara de Y1 errada (0x1FF em vez de 0x3FF)
@@DE
                self.display_y1.set((val & 0x3FF) as u16);
@@PARA
                self.display_y1.set((val & 0x1FF) as u16);
@@FIM

mutante: m4
rotulo: GP1(06h) X2 shift errado (>> 10 em vez de >> 12)
@@DE
                self.display_x2.set(((val >> 12) & 0xFFF) as u16);
@@PARA
                self.display_x2.set(((val >> 10) & 0xFFF) as u16);
@@FIM

mutante: m5
rotulo: GP1(07h) Y2 shift errado (>> 12 em vez de >> 10)
@@DE
                self.display_y2.set(((val >> 10) & 0x3FF) as u16);
@@PARA
                self.display_y2.set(((val >> 12) & 0x3FF) as u16);
@@FIM

mutante: m6
rotulo: GP1(00h) reset preserva display_vram_x/y (nao zera)
@@DE
                self.display_vram_x.set(0);
                self.display_vram_y.set(0);
@@PARA
                self.display_vram_x.set(0x3FF);
                self.display_vram_y.set(0x1FF);
@@FIM

mutante: m7
rotulo: GP1(00h) reset usa defaults errados para X1/X2
@@DE
                self.display_x1.set(0x260);
                self.display_x2.set(0x260 + 320 * 8);
@@PARA
                self.display_x1.set(0);
                self.display_x2.set(0);
@@FIM

controle: K1
rotulo: reordena blocos GP1(05h) e GP1(06h) (independentes, cosmético)
@@DE
            0x05 => {
                self.display_vram_x.set((val & 0x3FF) as u16);
                self.display_vram_y.set(((val >> 10) & 0x1FF) as u16);
            }
            0x06 => {
                self.display_x1.set((val & 0xFFF) as u16);
                self.display_x2.set(((val >> 12) & 0xFFF) as u16);
            }
@@PARA
            0x06 => {
                self.display_x1.set((val & 0xFFF) as u16);
                self.display_x2.set(((val >> 12) & 0xFFF) as u16);
            }
            0x05 => {
                self.display_vram_x.set((val & 0x3FF) as u16);
                self.display_vram_y.set(((val >> 10) & 0x1FF) as u16);
            }
@@FIM

controle: K2
rotulo: declara variavel local nao usada _cosmetic em write_gp1 (cosmetico)
@@DE
        let cmd = (val >> 24) as u8;
@@PARA
        let _cosmetic = 0u32;
        let cmd = (val >> 24) as u8;
@@FIM
