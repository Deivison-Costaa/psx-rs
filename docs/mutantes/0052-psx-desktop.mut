mutante: m1
rotulo: cycles_per_pix sempre retorna 10 (ignora HR1/HR2)
@@DE
    pub fn cycles_per_pix(&self) -> u16 {
        let stat = self.stat.get();
        let hr1 = (stat >> 17) & 3;
        let hr2 = (stat >> 16) & 1;
        if hr2 != 0 {
            7
        } else {
            match hr1 {
                0 => 10,
                1 => 8,
                2 => 5,
                _ => 4,
            }
        }
    }
@@PARA
    pub fn cycles_per_pix(&self) -> u16 {
        10
    }
@@FIM

mutante: m2
rotulo: display_width sem truncamento (& !3), retorna valor nao arredondado
@@DE
        ((range / self.cycles_per_pix()) + 2) & !3u16
@@PARA
