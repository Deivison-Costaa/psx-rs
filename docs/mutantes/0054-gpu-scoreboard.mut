# Manifesto de mutação da iteração 0054 — gpu-scoreboard
formato: 1
iteracao: 0054
item: 2.9
alvo: scripts/scoreboard.ps1
teste: gpu_scoreboard

mutante: m1
rotulo: scoreboard sem -Recurse (nao alcanca subdiretorios como gpu/)
@@DE
$candidateFiles = Get-ChildItem $ExeRoot -Include *.exe, *.psexe -Recurse | Sort-Object FullName
@@PARA
$candidateFiles = Get-ChildItem $ExeRoot -Include *.exe, *.psexe | Sort-Object FullName
@@FIM

mutante: m2
rotulo: scoreboard sem status tty (GPUs sem veredito textual seriam sem-saida)
@@DE
                if ($ttyBytes -gt 0) {
                    $rows += "$ts,$commit,$suite,$($candidate.Name),tty,"
                } else {
                    $rows += "$ts,$commit,$suite,$($candidate.Name),sem-saida,"
                }
@@PARA
                if ($ttyBytes -gt 0) {
                    $rows += "$ts,$commit,$suite,$($candidate.Name),sem-saida,"
                } else {
                    $rows += "$ts,$commit,$suite,$($candidate.Name),sem-saida,"
                }
@@FIM

mutante: m3
rotulo: scoreboard sem classificacao pass/fail (gp0-e1 e mask-bit nao teriam veredito)
@@DE
            $status = if ($failCount -gt 0) { 'fail' } else { 'pass' }
@@PARA
            $status = 'erro'
@@FIM

mutante: m4
rotulo: fetch-test-exes sem fonte ps1-tests (GPU nao seria baixada)
arquivo: scripts/fetch-test-exes.ps1
@@DE
    @{ Name = "ps1-tests"; Dir = "tests/exes/ps1-tests"
       Url = "https://github.com/JaCzekanski/ps1-tests/releases/download/$Ps1TestsTag/tests.zip" }
@@PARA
@@FIM

mutante: m5
rotulo: fetch-test-exes com menos de 3 fontes (remocao de amidog-gte)
arquivo: scripts/fetch-test-exes.ps1
@@DE
    @{ Name = "amidog-gte"; Dir = "tests/exes/amidog/gte"
       Url = "https://psx.amidog.se/lib/exe/fetch.php?media=psx:download:psxtest_gte.zip" }
@@PARA
@@FIM

controle: K1
rotulo: comentario cosmetico no scoreboard (nao altera comportamento)
@@DE
$ErrorActionPreference = "Stop"
@@PARA
# Comentario cosmetico — nao deve quebrar nenhum teste
$ErrorActionPreference = "Stop"
@@FIM

controle: K2
rotulo: linha em branco no fetch-test-exes (nao altera comportamento)
arquivo: scripts/fetch-test-exes.ps1
@@DE
$Ps1TestsTag = "build-158"
@@PARA

$Ps1TestsTag = "build-158"
@@FIM
