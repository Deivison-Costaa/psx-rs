controle: K2
rotulo: extrair condicao para variavel (refatoracao equivalente)
@@DE
        if (sr & 0x1) != 0 && (sr & (1 << 10)) != 0 && (self.cop0[13] & (1 << 10)) != 0 {
            if let Some((reg, val)) = self.load_delay.take() {
                self.set_reg(reg, val);
            }
