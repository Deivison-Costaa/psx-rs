@@PARA
        let deve_interromper = (sr & 0x1) != 0 && (sr & (1 << 10)) != 0 && (self.cop0[13] & (1 << 10)) != 0;
        if deve_interromper {
            if let Some((reg, val)) = self.load_delay.take() {
                self.set_reg(reg, val);
            }
            let ie_ku_shifted = ((sr & 0x3) << 2) | ((sr & 0xC) << 2);
@@FIM
