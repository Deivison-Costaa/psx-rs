controle: K1
rotulo: trocar 0xFFFF por 65535 (valor identico)
@@DE
                self.timers[idx].counter.set((val & 0xFFFF) as u16);
@@PARA
                self.timers[idx].counter.set((val & 65535) as u16);
@@FIM

controle: K2
rotulo: extrair mascara de bits 11-12 em constante
@@DE
                t.mode.set(val & !((1 << 11) | (1 << 12)));
@@PARA
                let flags_mask = (1 << 11) | (1 << 12);
                t.mode.set(val & !flags_mask);
@@FIM
