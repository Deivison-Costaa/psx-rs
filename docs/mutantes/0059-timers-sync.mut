item: 3.4b
alvo: crates/psx-core/src/timers.rs
teste: timers_sync

mutante: m1
rotulo: modo 0 nao pausa durante sync (timer 0 com hblank)
@@DE
                0 | 1 => match sync_mode {
                    0 => !sync_signal,
@@PARA
                0 | 1 => match sync_mode {
                    0 => true,
@@FIM

mutante: m2
rotulo: modo 2 nao pausa fora do sync (timer 1 com vblank)
@@DE
                    2 => sync_signal,
@@PARA
                    2 => true,
@@FIM

mutante: m3
rotulo: borda de subida do sync nao reseta cnt (modos 1 e 2)
@@DE
        if sync_enable && rising_edge {
            match sync_mode {
                1 | 2 => {
                    t.counter.set(0);
                    t.cycle_acc.set(0);
                }
@@PARA
        if false {
            match sync_mode {
                1 | 2 => {
                    t.counter.set(0);
                    t.cycle_acc.set(0);
                }
@@FIM

mutante: m4
rotulo: modo 3 nao detecta primeiro sync (nao sai do pause)
@@DE
        if sync_enable && rising_edge {
            match sync_mode {
                1 | 2 => {
                    t.counter.set(0);
                    t.cycle_acc.set(0);
                }
                3 if !t.mode3_triggered.get() => {
                    t.counter.set(0);
                    t.cycle_acc.set(0);
                    t.mode3_triggered.set(true);
                }
                _ => {}
            }
        }
@@PARA
        let _ = rising_edge;
@@FIM

mutante: m5
rotulo: timer 2 sync_enable=1 modo 1/2 nao incrementa (deveria ser free run)
@@DE
                2 => !matches!(sync_mode, 0 | 3),
@@PARA
                2 => false,
@@FIM

mutante: m6
rotulo: escrever MODE nao reseta prev_sync_signal e mode3_triggered
@@DE
                t.prev_sync_signal.set(false);
                t.mode3_triggered.set(false);
@@PARA
                let _ = mode;
@@FIM

mutante: m7
rotulo: modo 3 reseta cnt a cada sync mesmo depois de disparado
@@DE
                3 if !t.mode3_triggered.get() => {
                    t.counter.set(0);
                    t.cycle_acc.set(0);
                    t.mode3_triggered.set(true);
                }
@@PARA
                3 => {
                    t.counter.set(0);
                    t.cycle_acc.set(0);
                    t.mode3_triggered.set(true);
                }
@@FIM

controle: K1
rotulo: extrair sync_signal em variavel local (equivalente semantico)
@@DE
        let increment = if sync_enable {
            match idx {
                0 | 1 => match sync_mode {
                    0 => !sync_signal,
                    1 => true,
                    2 => sync_signal,
                    3 => t.mode3_triggered.get(),
                    _ => true,
                },
@@PARA
        let in_sync = sync_signal;
        let increment = if sync_enable {
            match idx {
                0 | 1 => match sync_mode {
                    0 => !in_sync,
                    1 => true,
                    2 => in_sync,
                    3 => t.mode3_triggered.get(),
                    _ => true,
                },
@@FIM

controle: K2
rotulo: renomear o acumulador de ciclos (semantica identica)
@@DE
        let prev_acc = t.cycle_acc.get() as u64;
        let total = prev_acc + (cycles as u64) * numer;
@@PARA
        let previous_acc = t.cycle_acc.get() as u64;
        let total = previous_acc + (cycles as u64) * numer;
@@FIM
