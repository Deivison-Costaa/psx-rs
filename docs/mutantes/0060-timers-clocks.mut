controle: K2
rotulo: extrair condicao de clock_src em variavel local (semantica identica)
@@DE
    pub fn tick(
        &mut self,
        base_addr: u32,
        cycles: u32,
        hblank_active: bool,
        vblank_active: bool,
    ) -> Option<u32> {
        let idx = Self::timer_index(base_addr);
        let t = &self.timers[idx];
        if t.bit10_restore_needed.get() {
            let m = t.mode.get();
            t.mode.set(m | (1 << 10));
            t.bit10_restore_needed.set(false);
        }
        let mode = t.mode.get();
        let sync_enable = mode & 1 != 0;
        let sync_mode = (mode >> 1) & 0x3;
        let reset_on_target = (mode >> 3) & 1 != 0;
        let clock_src = (mode >> 8) & 0x3;
@@PARA
    pub fn tick(
        &mut self,
        base_addr: u32,
        cycles: u32,
        hblank_active: bool,
        vblank_active: bool,
    ) -> Option<u32> {
        let idx = Self::timer_index(base_addr);
        let t = &self.timers[idx];
        if t.bit10_restore_needed.get() {
            let m = t.mode.get();
            t.mode.set(m | (1 << 10));
            t.bit10_restore_needed.set(false);
        }
        let mode = t.mode.get();
        let sync_enable = mode & 1 != 0;
        let sync_mode = (mode >> 1) & 0x3;
        let _sync_mode_copy = sync_mode;
        let reset_on_target = (mode >> 3) & 1 != 0;
        let clock_src = (mode >> 8) & 0x3;
@@FIM
