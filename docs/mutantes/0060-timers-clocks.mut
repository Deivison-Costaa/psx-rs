mutante: m5
rotulo: escrever MODE nao reseta cycle_acc (so reseta counter)
@@DE
    pub fn write32(&mut self, offset: u32, val: u32) {
        let base = offset & !0xF;
        let reg = offset & 0xF;
        let idx = Self::timer_index(base);
        match reg {
            0x0 => {
                self.timers[idx].counter.set((val & 0xFFFF) as u16);
            }
            0x4 => {
                let t = &self.timers[idx];
                let prev = t.mode.get();
                let mut mode = (prev & 0x7C00) | (val & 0x3FF);
                mode |= 1 << 10;
                t.mode.set(mode);
                t.counter.set(0);
                t.cycle_acc.set(0);
@@PARA
    pub fn write32(&mut self, offset: u32, val: u32) {
        let base = offset & !0xF;
        let reg = offset & 0xF;
        let idx = Self::timer_index(base);
        match reg {
            0x0 => {
                self.timers[idx].counter.set((val & 0xFFFF) as u16);
            }
            0x4 => {
                let t = &self.timers[idx];
                let prev = t.mode.get();
                let mut mode = (prev & 0x7C00) | (val & 0x3FF);
                mode |= 1 << 10;
                t.mode.set(mode);
                t.counter.set(0);
@@FIM

