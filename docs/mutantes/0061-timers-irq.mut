                        mode_now &= !(1 << 10);
                    }
                    mode_changed = true;
                    let new_bit10 = (mode_now >> 10) & 1;
                    if old_bit10 == 1 && new_bit10 == 0 {
                        irq_raised = true;
                    }
                    if irq_once {
                        t.irq_fired_oneshot.set(true);
                    }
                }
                if reset_on_target {
                    t.counter.set(0);
                }
            }
@@FIM
