mutante: m6
rotulo: flag target (bit11) ainda depende de reset_on_target (regressao)
@@DE
                if irq_enable_target && (!irq_once || !t.irq_fired_oneshot.get()) {
                    let old_bit10 = (mode_now >> 10) & 1;
                    if irq_toggle {
                        mode_now ^= 1 << 10;
                    } else {
                        mode_now &= !(1 << 10);
                        t.bit10_restore_needed.set(true);
                    }
                    mode_changed = true;
                    let new_bit10 = (mode_now >> 10) & 1;
                    if old_bit10 == 1 && new_bit10 == 0 {
                        irq_raised = true;
                    }
                    if irq_once {
                        t.irq_fired_oneshot.set(true);
                    }
                }
                if reset_on_target {
                    t.counter.set(0);
                }
@@PARA
                if reset_on_target {
                    t.counter.set(0);
                }
@@FIM

