@@FIM

mutante: m2
rotulo: SeekL sem disco retorna INT3 em vez de INT5 — condicao vira false
@@DE
                if !self.disc_inserted.get() {
                    self.result_push(self.stat_byte() | 0x01);
                    self.result_push(0x80);
                    self.intsts.set(5);
                    self.busy.set(false);
@@PARA
