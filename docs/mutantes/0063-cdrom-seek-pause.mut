                    self.result_push(self.stat_byte() | 0x01);
                    self.result_push(0x80);
                    self.intsts.set(5);
                    self.busy.set(false);
@@FIM

mutante: m3
rotulo: SeekL nao seta seeking flag — stat bit6 fica 0 durante seek
@@DE
                    self.seeking.set(true);
                    self.result_push(self.stat_byte());
@@PARA
                    self.result_push(self.stat_byte());
@@FIM

mutante: m4
rotulo: deliver_second do SeekL nao limpa seeking — stat bit6 fica 1 apos seek
@@DE
                self.busy.set(false);
                self.seeking.set(false);
@@PARA
                self.busy.set(false);
@@FIM

mutante: m5
rotulo: Pause nao gera segunda resposta — pending_second set(4) vira busy.set(false)
@@DE
                self.intsts.set(3);
                self.pending_second.set(4);
@@PARA
                self.intsts.set(3);
                self.busy.set(false);
@@FIM

