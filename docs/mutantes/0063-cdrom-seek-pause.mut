@@FIM

controle: K1
rotulo: extrair disc_inserted em variavel local no SeekL (equivalente semantico)
@@DE
                if !self.disc_inserted.get() {
                    self.result_push(self.stat_byte() | 0x01);
                    self.result_push(0x80);
                    self.intsts.set(5);
                    self.busy.set(false);
@@PARA
                let no_disc = !self.disc_inserted.get();
                if no_disc {
                    self.result_push(self.stat_byte() | 0x01);
                    self.result_push(0x80);
                    self.intsts.set(5);
                    self.busy.set(false);
@@FIM

controle: K2
rotulo: inline de stat_byte no Pause (equivalente semantico)
@@DE
                let stat = self.stat_byte();
                self.result_push(stat);
                self.intsts.set(3);
                self.pending_second.set(4);
@@PARA
                self.result_push(self.stat_byte());
                self.intsts.set(3);
                self.pending_second.set(4);
@@FIM
