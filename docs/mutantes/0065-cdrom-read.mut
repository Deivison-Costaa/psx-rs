                    }
@@FIM

mutante: m5
rotulo: buffer de dados preenchido com zeros — RDDATA retorna zeros
@@DE
                        *b = (i as u8).wrapping_add(1);
@@PARA
                        *b = 0;
@@FIM

mutante: m6
rotulo: data_pos nao eh resetado — DRQSTS fica desligado apos primeiro setor
@@DE
                self.data_pos.set(0);
@@PARA
                self.data_pos.set(2048);
@@FIM

mutante: m7
rotulo: ReadN nao seta reading flag no stat — stat bit5=0
@@DE
                    self.reading.set(true);
                    self.read_mode.set(1);
                    self.result_push(self.stat_byte());
                    self.intsts.set(3);
                    self.pending_second.set(5);
@@PARA
                    self.reading.set(false);
                    self.read_mode.set(1);
                    self.result_push(self.stat_byte());
                    self.intsts.set(3);
                    self.pending_second.set(5);
@@FIM

controle: K1
rotulo: extrair stat_byte em variavel local no deliver_second case 5 (equivalente semantico)
@@DE
                self.result_push(self.stat_byte());
                self.intsts.set(1);
@@PARA
                let st = self.stat_byte();
                self.result_push(st);
                self.intsts.set(1);
@@FIM

controle: K2
rotulo: usar if em vez de else if no comando ReadN sem disco (equivale semantico)
@@DE
                } else {
                    self.reading.set(true);
                    self.read_mode.set(1);
@@PARA
                }
                if self.disc_inserted.get() {
                    self.reading.set(true);
                    self.read_mode.set(1);
@@FIM
