@@FIM

mutante: m3
rotulo: deliver_second nao poe INT1 — pos INT2 (Read interrompido)
@@DE
                self.intsts.set(1);
@@PARA
                self.intsts.set(2);
@@FIM

mutante: m4
rotulo: ReadN nao encadeia — pending_second nao eh re-setado
@@DE
                    if pending == 5 && self.read_mode.get() == 1 {
                        self.pending_second.set(5);
                    }
@@PARA
