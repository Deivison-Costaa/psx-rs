# Manifesto de mutação da iteração 0065 — cdrom-read
formato: 1
iteracao: 0065
item: 4.2c
alvo: crates/psx-core/src/cdrom.rs
teste: cdrom_read
arquivada: registro m4 ancorava o handler do ack (HCLRCTL) que a 0134 reestruturou — entrega da 2a resposta saiu do ack e virou evento CDROM_SECOND no scheduler (4.4ac); placar historico preservado no .resultado

mutante: m1
rotulo: ReadN sem disco retorna INT3 em vez de INT5 — condicao vira false
@@DE
            0x06 => {
                if !self.disc_inserted.get() {
                    self.result_push(self.stat_byte() | 0x01);
                    self.result_push(0x80);
                    self.intsts.set(5);
                    self.busy.set(false);
@@PARA
            0x06 => {
                if false {
                    self.result_push(self.stat_byte() | 0x01);
                    self.result_push(0x80);
                    self.intsts.set(5);
                    self.busy.set(false);
@@FIM

mutante: m2
rotulo: ReadS sem disco retorna INT3 em vez de INT5 — condicao vira false
@@DE
            0x1B => {
                if !self.disc_inserted.get() {
                    self.result_push(self.stat_byte() | 0x01);
                    self.result_push(0x80);
                    self.intsts.set(5);
