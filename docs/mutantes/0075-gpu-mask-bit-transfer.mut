mutante: m5
rotulo: write-protect aplica a hw1 mas nao a hw2 (remove guarda so do hw2)
@@DE
                    let idx2 = py2 as usize * 1024 + px2 as usize;
                    if !check_mask || (self.vram[idx2] & 0x8000) == 0 {
                        let mut hw = hw2;
                        if force_bit15 {
