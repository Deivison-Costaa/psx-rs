                        }
                        self.vram[idx2] = hw;
                    }
@@PARA
                    let idx2 = py2 as usize * 1024 + px2 as usize;
                    self.vram[idx2] = hw2;
@@FIM

equivalente: m6
rotulo: mask-bit aplicado ANTES do write-protect (ordem trocada)
justificativa: check-protect le o pixel antigo da VRAM e force-bit15 modifica o pixel novo local — sao operacoes independentes. Nenhum teste pode distinguir a ordem.
@@DE
                let idx1 = py as usize * 1024 + px as usize;
                if !check_mask || (self.vram[idx1] & 0x8000) == 0 {
                    let mut hw = hw1;
                    if force_bit15 {
                        hw |= 0x8000;
                    }
                    self.vram[idx1] = hw;
                }
@@PARA
                let idx1 = py as usize * 1024 + px as usize;
                let mut hw = hw1;
                if force_bit15 {
                    hw |= 0x8000;
                }
                if !check_mask || (self.vram[idx1] & 0x8000) == 0 {
                    self.vram[idx1] = hw;
                }
@@FIM

