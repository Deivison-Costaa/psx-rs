# Manifesto de mutação da iteração 0085 — bios-i-mask
formato: 1
iteracao: 0085
item: 4.4c
alvo: crates/psx-core/src/irq.rs
teste: irq_halfword

mutante: m1
rotulo: write_stat_half substitui stat inteiro em vez de AND (garbage upper bits)
@@DE
    pub fn write_stat_half(&mut self, offset: u32, val: u16) {
        let shift = offset * 8;
        let val32 = (val as u32) << shift;
        let preserved = !(0xFFFFu32 << shift);
        self.stat &= val32 | preserved;
    }
@@PARA
    pub fn write_stat_half(&mut self, offset: u32, val: u16) {
        let shift = offset * 8;
        self.stat = (val as u32) << shift;
    }
@@FIM

mutante: m2
rotulo: write_mask_half nao limpa byte alvo antes de OR (mistura bits velhos)
@@DE
    pub fn write_mask_half(&mut self, offset: u32, val: u16) {
        let shift = offset * 8;
        let mask_half = ((val as u32) << shift) & 0x7FF;
        let clear = !(0xFFFFu32 << shift);
        self.mask = (self.mask & clear) | mask_half;
    }
@@PARA
    pub fn write_mask_half(&mut self, offset: u32, val: u16) {
        let shift = offset * 8;
        let mask_half = ((val as u32) << shift) & 0x7FF;
        self.mask |= mask_half;
    }
@@FIM

mutante: m3
rotulo: write_stat_byte desloca metade dos bits (offset*4 em vez de offset*8)
@@DE
        let shift = offset * 8;
        let val = (byte as u32) << shift;
        let preserved = !(0xFFu32 << shift);
        self.stat &= val | preserved;
@@PARA
        let shift = offset * 4;
        let val = (byte as u32) << shift;
        let preserved = !(0xFFu32 << shift);
        self.stat &= val | preserved;
@@FIM

mutante: m4
rotulo: write_mask_byte sem mascara 0x7FF — bits 11+ propagam lixo
@@DE
    pub fn write_mask_byte(&mut self, offset: u32, byte: u8) {
        let shift = offset * 8;
        let mask_byte = ((byte as u32) << shift) & 0x7FF;
        let clear = !(0xFFu32 << shift);
        self.mask = (self.mask & clear) | mask_byte;
    }
@@PARA
    pub fn write_mask_byte(&mut self, offset: u32, byte: u8) {
        let shift = offset * 8;
        let mask_byte = (byte as u32) << shift;
        let clear = !(0xFFu32 << shift);
        self.mask = (self.mask & clear) | mask_byte;
    }
@@FIM

