mutante: m2
rotulo: saturate_ir nunca satura (retorna val sem clamp)
@@DE
fn saturate_ir(val: i64, lm: u32, flag_bit: u32, flag: &mut u32, force_lm0: bool) -> i32 {
    let use_lm0 = force_lm0 || lm == 0;
    let (min_val, max_val) = if use_lm0 {
        (-0x8000i64, 0x7FFFi64)
    } else {
        (0i64, 0x7FFFi64)
    };
    if val > max_val {
        *flag |= 1 << flag_bit;
        max_val as i32
    } else if val < min_val {
        *flag |= 1 << flag_bit;
        min_val as i32
    } else {
        val as i32
    }
}
@@PARA
fn saturate_ir(val: i64, lm: u32, flag_bit: u32, flag: &mut u32, force_lm0: bool) -> i32 {
    val as i32
}
@@FIM

