@@PARA
        self.written_gpr = Some(idx ^ 1);
@@FIM

mutante: m5
rotulo: limpeza pre-execute vira Some(31) — load pendente para $ra some sem conflito
@@DE
        self.written_gpr = None;
@@PARA
        self.written_gpr = Some(31);
@@FIM

controle: c1
rotulo: None qualificado (cosmetico)
@@DE
