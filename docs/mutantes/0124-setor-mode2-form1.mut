@@PARA
    let cabecalho = if bin[offset + 0x0E] == 0x02 {
@@FIM

mutante: m4
rotulo: Mode2 pula so o sub-header, esquecendo a copia dele
@@DE
    let cabecalho = if bin[offset + 0x0F] == 0x02 {
        0x18
@@PARA
    let cabecalho = if bin[offset + 0x0F] == 0x02 {
        0x14
@@FIM

mutante: m5
rotulo: modo comparado com Mode1 em vez de Mode2, invertendo os dois offsets
@@DE
    let cabecalho = if bin[offset + 0x0F] == 0x02 {
        0x18
    } else {
        0x10
    };
@@PARA
    let cabecalho = if bin[offset + 0x0F] == 0x01 {
        0x18
    } else {
        0x10
    };
@@FIM

mutante: m6
rotulo: guarda de tamanho antes de ler o byte de modo removida
@@DE
    if offset + 0x10 > bin.len() {
        return None;
    }
@@PARA
    if offset > bin.len() {
        return None;
    }
@@FIM

controle: c1
rotulo: escolha do offset escrita com match em vez de if (equivalente)
@@DE
    let cabecalho = if bin[offset + 0x0F] == 0x02 {
        0x18
    } else {
        0x10
    };
@@PARA
    let cabecalho = match bin[offset + 0x0F] {
        0x02 => 0x18,
        _ => 0x10,
    };
@@FIM

controle: c2
rotulo: modo extraido para variavel local antes da comparacao (cosmetico)
