# Manifesto de mutação da iteração 0124 — setor-mode2-form1
formato: 1
iteracao: 0124
item: 4.4s
alvo: crates/psx-core/src/cdrom.rs
teste: cdrom_setor_mode2

mutante: m1
rotulo: volta ao offset fixo do Mode1 (o defeito original)
@@DE
    let cabecalho = if bin[offset + 0x0F] == 0x02 {
        0x18
    } else {
        0x10
    };
@@PARA
    let cabecalho = 0x10;
@@FIM

# O mutante "offset do Mode2 aplicado a todo setor" (cabecalho = 0x18 fixo) NAO entra aqui:
# ele ja e o m2 de 0077-acoplar-disclayout-cdrom.mut, reancorado nesta iteracao. Repetir a
# mesma edicao em dois manifestos so inflaria o placar.

mutante: m3
rotulo: byte de modo lido do lugar errado do cabecalho
@@DE
