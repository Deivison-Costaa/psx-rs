mutante: m1
rotulo: descoberta do binario volta a assumir o layout do npm do Windows
@@DE
$oc = if (-not $shim) {
    $null
} elseif ($IsWindows) {
    Join-Path (Split-Path $shim) "node_modules\opencode-ai\bin\opencode.exe"
} else {
    $shim
}
@@PARA
$oc = if ($shim) {
    Join-Path (Split-Path $shim) "node_modules\opencode-ai\bin\opencode.exe"
} else { $null }
@@FIM

