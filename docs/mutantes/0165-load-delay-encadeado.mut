controle: c1
rotulo: calcula o mesmo predicado usando map_or
ocorrencias: 1
@@DE
            let replaced_by_load = new_load.is_some_and(|(new_reg, _)| new_reg == reg);
@@PARA
            let replaced_by_load = new_load.map_or(false, |(new_reg, _)| new_reg == reg);
@@FIM

controle: c2
rotulo: calcula o mesmo predicado usando matches
ocorrencias: 1
@@DE
            let replaced_by_load = new_load.is_some_and(|(new_reg, _)| new_reg == reg);
@@PARA
            let replaced_by_load = matches!(new_load, Some((new_reg, _)) if new_reg == reg);
@@FIM

mutante: m6
rotulo: cancelar o load pendente descarta tambem o load recem-emitido
ocorrencias: 1
@@DE
        if let Some((reg, val)) = new_load {
            if reg != 0 {
                self.load_delay = Some((reg, val));
            }
        }
@@PARA
        if let Some((reg, _val)) = new_load {
            if reg != 0 {
                self.load_delay = None;
            }
