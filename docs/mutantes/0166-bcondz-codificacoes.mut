# Manifesto de mutacao da iteracao 0166 — bcondz: codificacoes de rt fora da tabela
formato: 1
iteracao: 0166
item: 10.92
alvo: crates/psx-core/src/cpu.rs
teste: cpu_bcondz_codificacoes

mutante: m1
rotulo: reintroduz o no-op para rt fora de 00/01/10/11
ocorrencias: 1
@@DE
        let link = rt == 0x10 || rt == 0x11;
        let cond = if rt & 0x01 == 0 {
            rs_val < 0
        } else {
            rs_val >= 0
        };
@@PARA
        let link = rt >= 16;
        let cond = match rt & 0x1F {
            0x00 => rs_val < 0,
            0x01 => rs_val >= 0,
            0x10 => rs_val < 0,
            0x11 => rs_val >= 0,
            _ => return,
        };
@@FIM

