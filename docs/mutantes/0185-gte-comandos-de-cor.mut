mutante: m1
rotulo: acumulador de 44 bits nao da a volta (usa o inteiro exato)
ocorrencias: todas
@@DE
fn sinal44(val: i64) -> i64 {
    (val << 20) >> 20
}
@@PARA
fn sinal44(val: i64) -> i64 {
    val
}
@@FIM

mutante: m2
rotulo: MAC deixa de ser registrador de 32 bits na leitura
@@DE
    fn le_mac(&self) -> (i64, i64, i64) {
        (
            self.regs[25] as i32 as i64,
            self.regs[26] as i32 as i64,
            self.regs[27] as i32 as i64,
        )
    }
@@PARA
    fn le_mac(&self) -> (i64, i64, i64) {
        (
            self.regs[25] as i64,
            self.regs[26] as i64,
            self.regs[27] as i64,
        )
    }
@@FIM

mutante: m3
