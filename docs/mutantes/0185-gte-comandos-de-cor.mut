controle: c2
rotulo: laco explicito no lugar do iterador da modulacao nao muda resultado
@@DE
        let m1 = canal((rgbc & 0xFF) as i64, ir[0]);
        let m2 = canal(((rgbc >> 8) & 0xFF) as i64, ir[1]);
