controle: c2
teste: library_identidade
rotulo: teto de setores escrito com if explicito em vez de min
ocorrencias: 1
@@DE
fn setores_de(tamanho: u32) -> u32 {
    tamanho
        .max(1)
        .div_ceil(BYTES_POR_SETOR as u32)
        .min(MAX_SETORES)
}
@@PARA
fn setores_de(tamanho: u32) -> u32 {
    let bruto = tamanho.max(1).div_ceil(BYTES_POR_SETOR as u32);
    if bruto > MAX_SETORES { MAX_SETORES } else { bruto }
}
@@FIM
