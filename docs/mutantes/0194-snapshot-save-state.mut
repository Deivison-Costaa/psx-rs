# Manifesto de mutacao da iteracao 0194 — snapshot do core e save states
formato: 1
iteracao: 0194
item: 9.2
alvo: crates/psx-core/src/snapshot.rs
teste: snapshot_estado

mutante: m1
teste: snapshot_estado
rotulo: RAM de 2 MiB fica de fora da restauracao
ocorrencias: 1
@@DE
