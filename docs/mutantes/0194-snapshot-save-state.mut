mutante: m11
teste: snapshot_estado
rotulo: magico deixa de ser conferido
ocorrencias: 1
@@DE
    if &bytes[0..8] != MAGICO {
        return Err(SnapshotError::Magico);
    }
@@PARA
    if bytes.len() < 8 {
        return Err(SnapshotError::Magico);
    }
@@FIM

mutante: m12
teste: snapshot_estado
rotulo: versao do formato deixa de ser conferida
ocorrencias: 1
@@DE
    if versao != VERSAO {
        return Err(SnapshotError::Versao(versao));
    }
@@PARA
    if versao == u32::MAX {
        return Err(SnapshotError::Versao(versao));
    }
@@FIM

mutante: m13
teste: snapshot_estado
rotulo: corpo comeca um byte antes do fim do cabecalho
ocorrencias: 1
@@DE
const CABECALHO: usize = 12;
@@PARA
const CABECALHO: usize = 11;
@@FIM

controle: c1
teste: snapshot_estado
rotulo: cabecalho montado sem reservar capacidade
ocorrencias: 1
@@DE
    let mut fora = Vec::with_capacity(CABECALHO);
@@PARA
    let mut fora = Vec::new();
@@FIM

controle: c2
teste: snapshot_estado
rotulo: versao lida por copy_from_slice em vez de indices soltos
ocorrencias: 1
@@DE
    let versao = u32::from_le_bytes([bytes[8], bytes[9], bytes[10], bytes[11]]);
@@PARA
    let mut quatro = [0u8; 4];
    quatro.copy_from_slice(&bytes[8..12]);
    let versao = u32::from_le_bytes(quatro);
@@FIM
