controle: c2
teste: memcard_saves
rotulo: leitura do u32 little-endian escrita com try_into
ocorrencias: 1
@@DE
    let f = bytes.get(em..em + 4)?;
    Some(u32::from_le_bytes([f[0], f[1], f[2], f[3]]))
@@PARA
    let f = bytes.get(em..em + 4)?;
    let mut quatro = [0u8; 4];
    quatro.copy_from_slice(f);
    Some(u32::from_le_bytes(quatro))
@@FIM
