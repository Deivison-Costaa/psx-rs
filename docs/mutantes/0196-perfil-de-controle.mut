mutante: m1
teste: input_perfil
rotulo: palavra do pad montada ligando bit em vez de apagando (polaridade invertida)
ocorrencias: 1
@@DE
                palavra &= !(1u16 << bit);
@@PARA
                palavra |= 1u16 << bit;
@@FIM

mutante: m2
teste: input_perfil
rotulo: religar uma entrada soma outra ligacao em vez de substituir
ocorrencias: 1
@@DE
        let mut ligacoes: Vec<(Entrada, u8)> = self
            .ligacoes
            .iter()
            .copied()
            .filter(|(e, _)| *e != entrada)
            .collect();
@@PARA
        let mut ligacoes: Vec<(Entrada, u8)> = self.ligacoes.to_vec();
@@FIM

mutante: m3
teste: input_perfil
rotulo: liga devolve copia do perfil antigo, perdendo a ligacao nova
ocorrencias: 1
@@DE
        ligacoes.push((entrada, bit));
        Ok(Perfil {
            nome: self.nome.clone(),
            ligacoes,
        })
@@PARA
        ligacoes.push((entrada, bit));
        Ok(self.clone())
@@FIM

