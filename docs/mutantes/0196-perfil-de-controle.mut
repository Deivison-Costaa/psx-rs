rotulo: busca da ligacao escrita com laco explicito
ocorrencias: 1
@@DE
        self.ligacoes
            .iter()
            .find(|(e, _)| *e == entrada)
            .map(|(_, b)| *b)
@@PARA
        for (e, b) in &self.ligacoes {
            if *e == entrada {
                return Some(*b);
            }
        }
        None
@@FIM

