controle: c2
teste: config_app
rotulo: pasta padrao escolhida por match em vez de if
ocorrencias: 1
@@DE
fn ou_padrao(valor: &str, padrao: &str) -> String {
    if valor.trim().is_empty() {
        padrao.to_string()
    } else {
        valor.to_string()
    }
}
@@PARA
fn ou_padrao(valor: &str, padrao: &str) -> String {
    match valor.trim() {
        "" => padrao.to_string(),
        _ => valor.to_string(),
    }
}
@@FIM
