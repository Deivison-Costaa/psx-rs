controle: c2
teste: sessao_recentes
rotulo: minutos formatados com aritmetica equivalente
ocorrencias: 1
@@DE
    let minutos = (segundos % SEGUNDOS_POR_HORA) / SEGUNDOS_POR_MINUTO;
    format!("{horas} h {minutos:02} min")
@@PARA
    let minutos = segundos / SEGUNDOS_POR_MINUTO - horas * 60;
    format!("{horas} h {minutos:02} min")
@@FIM
