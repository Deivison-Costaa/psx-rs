@@FIM

controle: c1
rotulo: nomear os canais antes do push nao muda comportamento
ocorrencias: 1
teste: vram_png
@@DE
        rgb.push(((px & 0x1F) << 3) as u8);
        rgb.push((((px >> 5) & 0x1F) << 3) as u8);
        rgb.push((((px >> 10) & 0x1F) << 3) as u8);
@@PARA
        let (r, g, b) = (px & 0x1F, (px >> 5) & 0x1F, (px >> 10) & 0x1F);
        rgb.push((r << 3) as u8);
        rgb.push((g << 3) as u8);
        rgb.push((b << 3) as u8);
@@FIM

