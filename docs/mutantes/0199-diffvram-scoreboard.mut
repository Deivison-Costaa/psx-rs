# Manifesto de mutacao da iteracao 0199 — conversor VRAM crua -> PNG do psx-cli
# Alvo fora do psx-core: bateria executada A MAO (invariante 29), resultado colado
# em 0199-diffvram-scoreboard.resultado. O wiring do scoreboard.ps1 nao tem mutante
# aqui: alvo .ps1 e pulado pelo portao e os meta-testes de ci_diffvram.rs cobrem texto.
formato: 1
iteracao: 0199
item: 10.23
alvo: crates/psx-cli/src/main.rs
teste: vram_png

mutante: m1
rotulo: canal vermelho na escala errada (<<2)
ocorrencias: 1
teste: vram_png
@@DE
