# Manifesto de mutacao da iteracao 0201 — mascara do indice de byte da GPU
formato: 1
iteracao: 0201
item: 10.51
alvo: crates/psx-core/src/bus.rs
teste: bus_gpu_byte_index_mask

mutante: m1
rotulo: remover a mascara final reintroduz o shift invalido
ocorrencias: 1
teste: bus_gpu_byte_index_mask
@@DE
                let val = self.gpu.peek32(base - 0x1F80_1810);
                let byte_index = ((phys & 3) + offset) & 3;
@@PARA
                let val = self.gpu.peek32(base - 0x1F80_1810);
                let byte_index = (phys & 3) + offset;
@@FIM

mutante: m2
rotulo: mascara com dois bits perde o byte superior correto
