controle: c1
rotulo: trocar a ordem da soma preserva o indice mascarado
ocorrencias: 1
teste: bus_gpu_byte_index_mask
@@DE
                let val = self.gpu.peek32(base - 0x1F80_1810);
                let byte_index = ((phys & 3) + offset) & 3;
@@PARA
                let val = self.gpu.peek32(base - 0x1F80_1810);
                let byte_index = (offset + (phys & 3)) & 3;
@@FIM

controle: c2
rotulo: mascarar o offset antes da soma preserva este contrato
ocorrencias: 1
teste: bus_gpu_byte_index_mask
@@DE
                let val = self.gpu.peek32(base - 0x1F80_1810);
                let byte_index = ((phys & 3) + offset) & 3;
@@PARA
                let val = self.gpu.peek32(base - 0x1F80_1810);
                let byte_index = ((phys & 3) + (offset & 3)) & 3;
@@FIM
