# Manifesto de mutacao da iteracao 0202 — 10.13: poligono texturizado modula pela cor
formato: 1
iteracao: 0202
item: 10.13
alvo: crates/psx-core/src/gpu.rs
teste: gpu_poligono_modulacao

mutante: m1
rotulo: escala errada — divide por 8 em vez de 16
ocorrencias: 1
teste: gpu_poligono_modulacao
@@DE
        ((t * c / 16).min(255) >> 3) as u16
@@PARA
        ((t * c / 8).min(255) >> 3) as u16
@@FIM

mutante: m2
rotulo: bit raw invertido — raw modula, blended fica cru
ocorrencias: 1
teste: gpu_poligono_modulacao
@@DE
                    if raw_texture {
                        texel
                    } else {
@@PARA
                    if !raw_texture {
                        texel
                    } else {
@@FIM

mutante: m3
rotulo: bit 15 (STP) do texel perdido apos a modulacao
ocorrencias: 1
teste: gpu_poligono_modulacao
@@DE
    canal(0, 0) | (canal(5, 8) << 5) | (canal(10, 16) << 10) | (texel & 0x8000)
@@PARA
    canal(0, 0) | (canal(5, 8) << 5) | (canal(10, 16) << 10)
@@FIM

mutante: m4
rotulo: canal R modula a cor por si mesma em vez de usar o texel
ocorrencias: 1
teste: gpu_poligono_modulacao
@@DE
    canal(0, 0) | (canal(5, 8) << 5) | (canal(10, 16) << 10) | (texel & 0x8000)
@@PARA
    ((((color24 & 0x1F) * (color24 & 0xFF) / 16).min(255) >> 3) as u16)
        | (canal(5, 8) << 5)
        | (canal(10, 16) << 10)
        | (texel & 0x8000)
@@FIM

mutante: m5
rotulo: teto do clamp em 15 em vez de 31 no valor de 5 bits
ocorrencias: 1
teste: gpu_poligono_modulacao
@@DE
        ((t * c / 16).min(255) >> 3) as u16
@@PARA
        (((t * c / 16).min(255) >> 3).min(15)) as u16
@@FIM

controle: c1
rotulo: renomear as variaveis locais do canal nao muda o resultado
ocorrencias: 1
teste: gpu_poligono_modulacao
@@DE
        let t = ((texel >> desloca_texel) & 0x1F) as u32;
        let c = (color24 >> desloca_cor) & 0xFF;
        ((t * c / 16).min(255) >> 3) as u16
@@PARA
        let componente_texel = ((texel >> desloca_texel) & 0x1F) as u32;
        let componente_cor = (color24 >> desloca_cor) & 0xFF;
        ((componente_texel * componente_cor / 16).min(255) >> 3) as u16
@@FIM

controle: c2
rotulo: ordem dos canais no OR final nao importa — cada um ocupa bits proprios
ocorrencias: 1
teste: gpu_poligono_modulacao
@@DE
    canal(0, 0) | (canal(5, 8) << 5) | (canal(10, 16) << 10) | (texel & 0x8000)
@@PARA
    (texel & 0x8000) | (canal(10, 16) << 10) | (canal(5, 8) << 5) | canal(0, 0)
@@FIM
