teste: gpu_gpuread_latch
@@DE
                let word = (hw1 as u32) | ((hw2 as u32) << 16);
                self.gpuread_latch.set(word);
                word
@@PARA
                let word = (hw1 as u32) | ((hw2 as u32) << 16);
                word
@@FIM

mutante: m3
rotulo: latch sempre gravado como zero em vez da palavra real
ocorrencias: 1
teste: gpu_gpuread_latch
@@DE
                let word = (hw1 as u32) | ((hw2 as u32) << 16);
                self.gpuread_latch.set(word);
                word
@@PARA
                let word = (hw1 as u32) | ((hw2 as u32) << 16);
                self.gpuread_latch.set(0);
                word
@@FIM

