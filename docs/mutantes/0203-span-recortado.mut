@@FIM

mutante: m5
rotulo: dx_span usa a largura ja recortada em vez da largura original
ocorrencias: 1
teste: gpu_span_recortado
@@DE
            let dx_span = xr - xl;
@@PARA
            let dx_span = xr.max(0).min(area_x2 + 1).min(1024) - xl.max(area_x1).max(0);
@@FIM

controle: c1
rotulo: trocar a ordem das duas declaracoes de span nao muda o resultado
