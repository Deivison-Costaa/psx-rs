# Manifesto de mutacao da iteracao 0203 — 10.42: framebuffer so muda no vblank
formato: 1
iteracao: 0203
item: 10.42
alvo: crates/psx-core/src/gpu.rs
teste: gpu_vblank_snapshot

mutante: m1
rotulo: enter_vblank para de latchar o snapshot da VRAM
ocorrencias: 1
teste: gpu_vblank_snapshot
@@DE
        self.display_snapshot.copy_from_slice(&self.vram);
@@PARA
        let _ = &self.vram;
@@FIM

mutante: m2
rotulo: framebuffer volta a ler VRAM ao vivo em vez do snapshot
ocorrencias: 1
teste: gpu_vblank_snapshot
@@DE
                    let pixel = self.display_snapshot[row + ((start_x + x) & 0x3FF)];
@@PARA
                    let pixel = self.vram[row + ((start_x + x) & 0x3FF)];
@@FIM

mutante: m3
rotulo: direcao da copia invertida — vram e sobrescrita pelo snapshot vazio
ocorrencias: 1
teste: gpu_vblank_snapshot
@@DE
        self.display_snapshot.copy_from_slice(&self.vram);
@@PARA
        self.vram.copy_from_slice(&self.display_snapshot);
@@FIM

mutante: m4
rotulo: latch acontece no exit_vblank, nao no enter_vblank
ocorrencias: 1
teste: gpu_vblank_snapshot
@@DE
        self.display_snapshot.copy_from_slice(&self.vram);
    }
@@PARA
    }
@@FIM
@@DE
    pub fn exit_vblank(&mut self) {
        self.in_vblank.set(false);
    }
@@PARA
    pub fn exit_vblank(&mut self) {
        self.in_vblank.set(false);
        self.display_snapshot.copy_from_slice(&self.vram);
    }
@@FIM

