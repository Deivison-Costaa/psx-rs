@@FIM

mutante: m5
rotulo: comparacao vira faixa aberta (pega SWC2 tambem)
@@DE
        if (0x20..=0x26).contains(&primary) || primary == 0x32 {
@@PARA
        if (0x20..=0x26).contains(&primary) || primary >= 0x32 {
@@FIM

controle: c1
rotulo: comentario antes do predicado de custo de load
@@DE
        let primary = instr >> 26;
        if (0x20..=0x26).contains(&primary) || primary == 0x32 {
@@PARA
        let primary = instr >> 26;
        // LWC2 le memoria como qualquer outro load, paga o mesmo custo de regiao
        if (0x20..=0x26).contains(&primary) || primary == 0x32 {
@@FIM

controle: c2
rotulo: comentario antes do calculo de endereco
@@DE
            let rs = ((instr >> 21) & 0x1F) as usize;
            let addr = self.reg(rs).wrapping_add(Self::sign_extend_imm(instr));
@@PARA
            // rs e imm ficam no mesmo lugar do encoding em todos esses opcodes
            let rs = ((instr >> 21) & 0x1F) as usize;
            let addr = self.reg(rs).wrapping_add(Self::sign_extend_imm(instr));
@@FIM
