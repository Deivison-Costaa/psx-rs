@@FIM

mutante: m6
rotulo: prazo do comando novo perde o ciclo de emissao (+1)
@@DE
                self.gte_busy_until = bus.total_cycles() + 1 + self.extra_cycles as u64 + custo;
@@PARA
                self.gte_busy_until = bus.total_cycles() + self.extra_cycles as u64 + custo;
@@FIM

mutante: m7
rotulo: gte_stall le o prazo errado (hilo_busy_until em vez de gte_busy_until -- cruza HI/LO com GTE)
@@DE
    fn gte_stall(&mut self, bus: &Bus) {
        let atraso = self.gte_busy_until.saturating_sub(bus.total_cycles());
@@PARA
    fn gte_stall(&mut self, bus: &Bus) {
        let atraso = self.hilo_busy_until.saturating_sub(bus.total_cycles());
@@FIM

