mutante: m3
rotulo: remove o ultimo evento pendente em vez do primeiro (quebra a ordem por prazo)
teste: bus_scheduler
@@DE
        let (key, id) = self.events.remove(0);
@@PARA
        let (key, id) = self.events.remove(self.events.len() - 1);
@@FIM

mutante: m4
rotulo: SPU_TICK volta a reagendar a partir de total_cycles em vez do prazo que venceu
arquivo: crates/psx-core/src/bus.rs
teste: bus_scheduler_periodico
@@DE
                    self.scheduler.schedule(
                        ScheduleKey::new(prazo + spu::CPU_CYCLES_PER_SAMPLE),
                        EventId(SPU_TICK),
                    );
@@PARA
                    self.scheduler.schedule(
                        ScheduleKey::new(self.total_cycles + spu::CPU_CYCLES_PER_SAMPLE),
                        EventId(SPU_TICK),
                    );
@@FIM

mutante: m5
rotulo: VBLANK_ENTER volta a reagendar a partir de total_cycles em vez do prazo que venceu
arquivo: crates/psx-core/src/bus.rs
teste: bus_scheduler_periodico
@@DE
                    self.scheduler
                        .schedule(ScheduleKey::new(prazo + frame), EventId(VBLANK_ENTER));
@@PARA
                    self.scheduler
                        .schedule(ScheduleKey::new(self.total_cycles + frame), EventId(VBLANK_ENTER));
@@FIM

