# Manifesto de mutação da iteração 0217 — dma-cobra-ciclos
formato: 1
iteracao: 0217
item: 0217.1
alvo: crates/psx-core/src/bus.rs
teste: dma_cobra_ciclos

mutante: m1
rotulo: charge_dma calcula o custo mas nao o acumula (DMA volta a custar 0)
@@DE
        self.dma_extra_cycles += ram_side as u32;
@@PARA
        let _ = ram_side as u32;
@@FIM

mutante: m2
rotulo: tick_timers para de somar o custo de DMA pendente
@@DE
        let cycles = cycles + std::mem::take(&mut self.dma_extra_cycles);
@@PARA
        let _ = std::mem::take(&mut self.dma_extra_cycles);
@@FIM

mutante: m3
rotulo: charge_dma ignora a contagem de palavras (custo fixo por canal)
@@DE
        let ram_side = Dma::stall_cost(words as u32);
@@PARA
        let ram_side = Dma::stall_cost(1);
@@FIM

mutante: m4
rotulo: tick_timers le o acumulador sem drenar — custo de DMA se repete no proximo tick
@@DE
        let cycles = cycles + std::mem::take(&mut self.dma_extra_cycles);
@@PARA
        let cycles = cycles + self.dma_extra_cycles;
@@FIM

mutante: m5
rotulo: charge_dma sobrescreve em vez de acumular — dois DMAs no mesmo tick perdem o primeiro
@@DE
        self.dma_extra_cycles += ram_side as u32;
@@PARA
        self.dma_extra_cycles = ram_side as u32;
@@FIM

